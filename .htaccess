# AI Form Multi Tasks · protección básica en Apache (IONOS)
Options -Indexes
DirectoryIndex index.php

# Nada de acceso directo a la configuración, librerías ni datos
<FilesMatch "^(config\.php|config\.sample\.php|README\.md|\.gitignore)$">
  Require all denied
</FilesMatch>
RedirectMatch 403 ^.*/(lib|data|\.git)(/|$)

# App instalable (PWA)
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
