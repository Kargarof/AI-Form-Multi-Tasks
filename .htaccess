# AI Form Multi Tasks · protección básica en Apache (IONOS)
Options -Indexes
DirectoryIndex index.php

# Nada de acceso directo a la configuración, librerías ni datos.
# (En IONOS «Require all denied» dentro de FilesMatch no se aplica; RedirectMatch sí.)
RedirectMatch 403 ^.*/(config\.php|config\.sample\.php|README\.md|\.gitignore|\.htaccess)$
RedirectMatch 403 ^.*/(lib|data|\.git|\.github)(/|$)

# App instalable (PWA)
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
